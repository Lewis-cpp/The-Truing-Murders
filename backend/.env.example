# Local development only. Docker creates this user as a database administrator.
POSTGRES_USER=truing
POSTGRES_PASSWORD=truing_local
POSTGRES_DB=truing
POSTGRES_PORT=5432

# Keep credentials and port consistent with the Docker settings above.
DATABASE_URL=postgresql+psycopg://truing:truing_local@127.0.0.1:5432/truing
TEST_DATABASE_URL=postgresql+psycopg://truing:truing_local@127.0.0.1:5432/truing_test

# Model generation stays off by default: the game runs on fixed replies.
# LLM_ENABLED=true requires all three of LLM_BASE_URL, LLM_MODEL and LLM_API_KEY.
LLM_ENABLED=false
LLM_ENABLED_NPCS=["NPC01","NPC02","NPC03","NPC04"]
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=400
LLM_SESSION_CALL_LIMIT=60
LLM_SESSION_TOKEN_LIMIT=200000
LLM_CONCURRENCY=4

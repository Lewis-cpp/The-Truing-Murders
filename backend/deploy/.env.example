# Deployment configuration for backend/deploy/compose.yaml.
# Copy to backend/deploy/.env and edit. Never commit the filled-in file.

# PostgreSQL account created on first start of the named volume.
POSTGRES_USER=truing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truing

# Browser origin that reaches the site; writes are rejected for other origins.
ALLOWED_ORIGINS=["http://127.0.0.1:8080"]

# Cookie security: keep true whenever the site is served over HTTPS (a reverse
# proxy with TLS, for example). For a plain-HTTP demo set false; browsers treat
# http://localhost and http://127.0.0.1 as secure contexts regardless.
COOKIE_SECURE=true

# Model generation is off by default; the game runs on fixed replies.
# Enabling it requires all three of LLM_BASE_URL, LLM_MODEL and LLM_API_KEY.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Port published for the web container.
WEB_PORT=8080
